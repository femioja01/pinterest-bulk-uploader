# Timezone
TZ=Africa/Lagos

# App secret key (for session security — change this!)
SECRET_KEY=change-me-to-a-random-string

# Initial upload schedule (cron expression) — can be changed from dashboard
UPLOAD_SCHEDULE=0 9 * * *

# Default batch size (max 100)
DEFAULT_BATCH_SIZE=50

# Delay between batch uploads in seconds
BATCH_DELAY_SECONDS=30

# Data directory (inside container)
DATA_DIR=/app/data
